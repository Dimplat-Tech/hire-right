# Enforce consistent line endings across platforms
# Auto-detect text files and normalize to LF in the repository
* text=auto

# Force LF for common text files
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
